{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/routes/*.js": {
      "maxDuration": 60,
      "includeFiles": "data/**"
    },
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "data/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; frame-src https://www.openstreetmap.org; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "framework": null,
  "buildCommand": ""
}
