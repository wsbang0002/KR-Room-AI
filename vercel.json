{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/routes/*.js": {
      "maxDuration": 60,
      "includeFiles": "data/**"
    },
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "data/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; frame-src https://www.openstreetmap.org; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "framework": null,
  "buildCommand": "",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    }
  ],
  "env": {
    "PUBLIC_SAVED_LISTINGS": "true",
    "PUBLIC_SAVED_LISTINGS_PRODUCTION_HOST": "kr-room-ai.vercel.app",
    "APIFY_MONTHLY_BUDGET_USD": "10.00",
    "APIFY_SOFT_STOP_USD": "9.00",
    "APIFY_MAX_COST_USD": "0.51",
    "GEMINI_PRIMARY_MODEL": "gemini-3.6-flash",
    "WALKING_ROUTES_PRODUCTION_HOST": "kr-room-ai.vercel.app"
  }
}
