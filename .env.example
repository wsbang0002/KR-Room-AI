# Node >=20.19: copy to .env locally; Vercel: set SERVER environment variables.
# Keep keys secret. Private real-data mode and paid APIs are locked by default.
ADMIN_API_KEY=
DATA_RIGHTS_REVIEWED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
APIFY_TOKEN=
APIFY_DATASET_ID=
ENABLE_LIVE_COLLECTION=false
APIFY_MAX_COST_USD=0.50
APIFY_DAILY_BUDGET_USD=1.00
COLLECTION_DAILY_LIMIT=2
CACHE_TTL_SECONDS=3600
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Adapter only; not connected to public search. No transit provider yet.
ENABLE_ROUTE_API=false
TMAP_API_KEY=
# Read-only Apify account hard-limit check before every new Actor reservation.
APIFY_MONTHLY_BUDGET_USD=5.00
APIFY_SOFT_STOP_USD=4.50
# Regional search cache; listing records and indexes have no TTL.
SEARCH_CACHE_TTL_SECONDS=86400
