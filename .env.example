# Node >=20.19: copy to .env locally; Vercel: set SERVER environment variables.
# Keep keys secret. Private real-data mode and paid APIs are locked by default.
ADMIN_API_KEY=
DATA_RIGHTS_REVIEWED=false
# Production allows anonymous read-only browsing of previously saved listings.
PUBLIC_SAVED_LISTINGS=false
# Select openrouter-free to use only OpenRouter free models for AI analysis.
AI_PROVIDER=gemini
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
APIFY_TOKEN=
APIFY_DATASET_ID=
ENABLE_LIVE_COLLECTION=false
# Each new Actor run requests up to 20 detailed listings against the monthly budget.
APIFY_MAX_COST_USD=0.51
CACHE_TTL_SECONDS=3600
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# TMAP Free walking and car routes share the app limit.
# Bus times prefer Kakao when a REST API key is configured. Use an app with the
# Kakao Map free quota badge and paid Kakao Map usage disabled. Keys are server-only.
KAKAO_REST_API_KEY=
KAKAO_TRANSIT_DAILY_APP_LIMIT=100
# Optional TMAP provider when Kakao is not configured. Use a Transit FREE key.
TMAP_TRANSIT_APP_KEY=
TMAP_TRANSIT_DAILY_APP_LIMIT=10
TMAP_APP_KEY=
ENABLE_WALKING_ROUTES=false
ENABLE_TMAP_DIAGNOSTICS=false
TMAP_DAILY_APP_LIMIT=200
TMAP_MAX_ROUTES_PER_SEARCH=5
TMAP_ROUTE_CACHE_ALLOWED=false
# Apify spending limits in USD. Account limit is read before each new Actor.
# Effective collection stop also caps spending at 90% of the account hard limit.
APIFY_MONTHLY_BUDGET_USD=10.00
APIFY_SOFT_STOP_USD=9.00
# Regional search cache; listing records and indexes have no TTL.
SEARCH_CACHE_TTL_SECONDS=86400
# Gemini condition extraction: search caps at 15s, admin generation check at 35s.
GEMINI_TIMEOUT_MS=35000
